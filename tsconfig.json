{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@watchtowerobservability/node": ["src/index.ts"],
      "@watchtowerobservability/node/*": ["src/integrations/*.ts"]
    }
  },
  "include": ["src", "test", "examples/basic.ts"]
}
